@@ -0,0 +1,32 @@
+package com.autosense.launcher
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class GpsFixPolicyTest {
+    private val now = 100_000_000_000L
+
+    @Test fun fixDeAhoraEsReciente() = assertTrue(GpsFixPolicy.isFresh(now, now))
+
+    @Test fun fixDeCincoSegundosExactosEsReciente() =
+        assertTrue(GpsFixPolicy.isFresh(now, now - GpsFixPolicy.MAX_FIX_AGE_NANOS))
+
+    @Test fun fixUnNanosegundoMasViejoNoEsReciente() =
+        assertFalse(GpsFixPolicy.isFresh(now, now - GpsFixPolicy.MAX_FIX_AGE_NANOS - 1))
+
+    @Test fun fixDelFuturoNoEsReciente() = assertFalse(GpsFixPolicy.isFresh(now, now + 1))
+
+    @Test fun conviertePorMetroPorSegundoAKmH() {
+        assertEquals(36, GpsFixPolicy.speedKmh(10f))
+        assertEquals(0, GpsFixPolicy.speedKmh(0f))
+        assertEquals(1, GpsFixPolicy.speedKmh(0.14f)) // 0,504 km/h se redondea a 1
+    }
+
+    @Test fun valoresInvalidosSonSinSenal() {
+        assertEquals(GpsFixPolicy.NO_SIGNAL, GpsFixPolicy.speedKmh(Float.NaN))
+        assertEquals(GpsFixPolicy.NO_SIGNAL, GpsFixPolicy.speedKmh(Float.POSITIVE_INFINITY))
+        assertEquals(GpsFixPolicy.NO_SIGNAL, GpsFixPolicy.speedKmh(-1f))
+    }
+
+    @Test fun sinSenalEsMenosUno() = assertEquals(-1, GpsFixPolicy.NO_SIGNAL)
+}
diff --git a/AutoSense/app/src/test/java/com/autosense/launcher/ManifestDecisionsTest.kt b/AutoSense/app/src/test/java/com/autosense/launcher/ManifestDecisionsTest.kt

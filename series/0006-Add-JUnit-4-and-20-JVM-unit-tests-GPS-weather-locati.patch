+package com.autosense.launcher
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class WeatherLocationPolicyTest {
+
+    @Test fun prefiereElGps() =
+        assertEquals(Pair(-34.1, -70.7), WeatherLocationPolicy.resolve(-34.1, -70.7, "10.0", "20.0"))
+
+    @Test fun sinGpsUsaLaUltimaGuardada() =
+        assertEquals(Pair(-34.1, -70.7), WeatherLocationPolicy.resolve(null, null, "-34.1", "-70.7"))
+
+    @Test fun sinNingunaUbicacionDevuelveNullYNoInventaCiudad() =
+        assertNull(WeatherLocationPolicy.resolve(null, null, null, null))
+
+    @Test fun gpsInvalidoCaeALaGuardada() =
+        assertEquals(Pair(1.0, 2.0), WeatherLocationPolicy.resolve(999.0, 0.0, "1.0", "2.0"))
+
+    @Test fun guardadaIlegibleDevuelveNull() {
+        assertNull(WeatherLocationPolicy.resolve(null, null, "abc", "20"))
+        assertNull(WeatherLocationPolicy.resolve(null, null, "NaN", "20"))
+        assertNull(WeatherLocationPolicy.resolve(null, null, "10", null))
+    }
+
+    @Test fun fueraDeRangoEsInvalido() {
+        assertFalse(WeatherLocationPolicy.isValid(90.1, 0.0))
+        assertFalse(WeatherLocationPolicy.isValid(0.0, -180.1))
+        assertTrue(WeatherLocationPolicy.isValid(-90.0, 180.0))
+    }
+}

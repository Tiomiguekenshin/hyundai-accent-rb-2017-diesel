@@ -0,0 +1,57 @@
+package com.autosense.launcher
+
+import org.junit.Assert.*
+import org.junit.Test
+
+import org.w3c.dom.Element
+import java.io.File
+import javax.xml.parsers.DocumentBuilderFactory
+
+/** Protege las decisiones del propietario y las correcciones de Android 14+ escritas en el manifest. */
+class ManifestDecisionsTest {
+    private val ns = "http://schemas.android.com/apk/res/android"
+
+    private val doc = DocumentBuilderFactory.newInstance().apply { isNamespaceAware = true }
+        .newDocumentBuilder()
+        .parse(listOf("src/main/AndroidManifest.xml", "app/src/main/AndroidManifest.xml").map { File(it) }.first { it.exists() })
+
+    private fun attr(e: Element, name: String) = e.getAttributeNS(ns, name)
+
+    private fun elements(tag: String) = doc.getElementsByTagName(tag).let { l -> (0 until l.length).map { l.item(it) as Element } }
+
+    private fun byName(tag: String, name: String) = elements(tag).first { attr(it, "name") == name }
+
+    private fun names(parent: Element, tag: String) =
+        parent.getElementsByTagName(tag).let { l -> (0 until l.length).map { attr(l.item(it) as Element, "name") } }
+
+    @Test fun mainActivityEsAppNormalSinCategoriaHome() {
+        val filter = byName("activity", ".MainActivity").getElementsByTagName("intent-filter").item(0) as Element
+        assertEquals(listOf("android.intent.action.MAIN"), names(filter, "action"))
+        val categories = names(filter, "category")
+        assertTrue(categories.contains("android.intent.category.LAUNCHER"))
+        assertTrue(categories.contains("android.intent.category.DEFAULT"))
+        assertFalse(categories.contains("android.intent.category.HOME"))
+    }
+
+    @Test fun ningunaActividadPideSerLauncherDelSistema() =
+        assertTrue(elements("category").none { attr(it, "name") == "android.intent.category.HOME" })
+
+    @Test fun servicioEnPrimerPlanoDeclaraTipoYPermisoDeAndroid14() {
+        val service = byName("service", ".DriveOverlayService")
+        assertEquals("specialUse", attr(service, "foregroundServiceType"))
+        assertEquals("false", attr(service, "exported"))
+        assertTrue(names(doc.documentElement, "uses-permission").contains("android.permission.FOREGROUND_SERVICE_SPECIAL_USE"))
+        assertTrue(names(service, "property").contains("android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"))
+    }
+
+    @Test fun bluetoothSeparaPermisosNuevosYAntiguos() {
+        assertTrue(names(doc.documentElement, "uses-permission").contains("android.permission.BLUETOOTH_CONNECT"))
+        for (legacy in listOf("android.permission.BLUETOOTH", "android.permission.BLUETOOTH_ADMIN")) {
+            val e = elements("uses-permission").first { attr(it, "name") == legacy }
+            assertEquals("30", attr(e, "maxSdkVersion"))
+        }
+    }
+
+    @Test fun bootReceiverNoEstaExpuesto() =
+        assertEquals("false", attr(byName("receiver", ".BootReceiver"), "exported"))
+}

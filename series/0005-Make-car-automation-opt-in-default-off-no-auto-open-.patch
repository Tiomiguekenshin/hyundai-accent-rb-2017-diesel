@@ -0,0 +1,9 @@
+package com.autosense.launcher
+
+/** Regla pura: la automatización con el carro viene desactivada salvo que el propietario la active. */
+object AutoStartPolicy {
+    /** Primera versión: AutoSense no se abre sola ni cambia ajustes del sistema. */
+    const val DEFAULT_ENABLED = false
+
+    fun effective(stored: Boolean?): Boolean = stored ?: DEFAULT_ENABLED
+}

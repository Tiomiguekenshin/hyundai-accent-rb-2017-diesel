+package com.autosense.launcher
+
+import android.content.Context
+
+/** Interruptor persistente de la automatización con el carro (menú del botón ⏻). */
+object AutoStart {
+    private const val PREFS = "car_power"
+    private const val KEY = "auto_enabled"
+
+    fun isEnabled(context: Context): Boolean {
+        val prefs = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        return AutoStartPolicy.effective(if (prefs.contains(KEY)) prefs.getBoolean(KEY, false) else null)
+    }
+
+    fun setEnabled(context: Context, enabled: Boolean) {
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putBoolean(KEY, enabled).apply()
+    }
+}

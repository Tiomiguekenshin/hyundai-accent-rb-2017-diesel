index 0000000..798463d
--- /dev/null
+++ b/AutoSense/app/src/main/java/com/autosense/launcher/GpsFixPolicy.kt
@@ -0,0 +1,19 @@
+package com.autosense.launcher
+
+import kotlin.math.roundToInt
+
+/** Reglas puras (sin Android) para decidir qué velocidad del GPS se muestra. */
+object GpsFixPolicy {
+    /** Antigüedad máxima (ns) de un fix GPS para mostrar su velocidad: 5 s. */
+    const val MAX_FIX_AGE_NANOS = 5_000_000_000L
+
+    /** Valor que el velocímetro interpreta como "sin señal GPS". */
+    const val NO_SIGNAL = -1
+
+    /** Un fix es reciente si no es del futuro y tiene como máximo [MAX_FIX_AGE_NANOS]. */
+    fun isFresh(nowNanos: Long, fixNanos: Long): Boolean = (nowNanos - fixNanos) in 0L..MAX_FIX_AGE_NANOS
+
+    /** m/s a km/h redondeado; un valor no válido (NaN, infinito o negativo) es [NO_SIGNAL]. */
+    fun speedKmh(speedMs: Float): Int =
+        if (speedMs.isNaN() || speedMs.isInfinite() || speedMs < 0f) NO_SIGNAL else (speedMs * 3.6f).roundToInt()
+}
diff --git a/AutoSense/app/src/main/java/com/autosense/launcher/WeatherLocationPolicy.kt b/AutoSense/app/src/main/java/com/autosense/launcher/WeatherLocationPolicy.kt
new file mode 100644
index 0000000..e21d96d
--- /dev/null
+++ b/AutoSense/app/src/main/java/com/autosense/launcher/WeatherLocationPolicy.kt
@@ -0,0 +1,19 @@
+package com.autosense.launcher
+
+/**
+ * Elige la ubicación para el pronóstico: primero la del GPS, luego la última guardada.
+ * Si no hay ninguna válida devuelve null (antes se usaba Ciudad de México por defecto).
+ */
+object WeatherLocationPolicy {
+
+    fun isValid(lat: Double, lon: Double): Boolean =
+        lat.isFinite() && lon.isFinite() && lat in -90.0..90.0 && lon in -180.0..180.0
+
+    fun resolve(gpsLat: Double?, gpsLon: Double?, storedLat: String?, storedLon: String?): Pair<Double, Double>? {
+        if (gpsLat != null && gpsLon != null && isValid(gpsLat, gpsLon)) return Pair(gpsLat, gpsLon)
+        val lat = storedLat?.toDoubleOrNull()
+        val lon = storedLon?.toDoubleOrNull()
+        if (lat != null && lon != null && isValid(lat, lon)) return Pair(lat, lon)
+        return null
+    }
+}
